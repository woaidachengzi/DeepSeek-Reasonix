{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonix.local/schemas/desktop-bridge/v1.json",
  "title": "Reasonix Desktop Bridge Protocol v1",
  "description": "JSON request and response bodies for the private loopback HTTP bridge. Route parameters are documented in BRIDGE_PROTOCOL.md.",
  "oneOf": [
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/providerSummaryResponse" },
    { "$ref": "#/$defs/setDefaultModelRequest" },
    { "$ref": "#/$defs/openSessionRequest" },
    { "$ref": "#/$defs/renameSessionRequest" },
    { "$ref": "#/$defs/attachFileRequest" },
    { "$ref": "#/$defs/attachmentResponse" },
    { "$ref": "#/$defs/submitRequest" },
    { "$ref": "#/$defs/sessionResponse" },
    { "$ref": "#/$defs/historyResponse" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "protocolVersion": { "type": "integer", "const": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "session": {
      "type": "object",
      "required": ["id", "path", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/sessionId" },
        "path": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "workspaceRoot": { "type": "string" },
        "state": { "enum": ["idle", "running", "paused"] }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": ["protocolVersion", "status", "sidecarInstanceId", "capabilities"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "status": { "const": "ok" },
        "sidecarInstanceId": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "providerSummary": {
      "title": "BridgeProviderSummary",
      "type": "object",
      "required": ["name", "kind", "models", "modelCount", "requiresKey", "configured"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" },
        "kind": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" } },
        "modelCount": { "type": "integer", "minimum": 0 },
        "requiresKey": { "type": "boolean" },
        "configured": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "setDefaultModelRequest": {
      "title": "BridgeSetDefaultModelRequest",
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "providerSummaryResponse": {
      "title": "BridgeProviderSummaryResponse",
      "type": "object",
      "required": ["protocolVersion", "defaultModel", "providers"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "defaultModel": { "type": "string" },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/providerSummary" } }
      },
      "additionalProperties": false
    },
    "openSessionRequest": {
      "type": "object",
      "required": ["sessionId"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "workspaceRoot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "renameSessionRequest": {
      "title": "BridgeRenameSessionRequest",
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "submitRequest": {
      "type": "object",
      "required": ["input"],
      "properties": {
        "input": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "attachFileRequest": {
      "type": "object",
      "required": ["sessionId", "path"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "required": ["path", "name", "size", "isImage"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "isImage": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "attachmentResponse": {
      "type": "object",
      "required": ["protocolVersion", "attachment"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "attachment": { "$ref": "#/$defs/attachment" }
      },
      "additionalProperties": false
    },
    "sessionResponse": {
      "type": "object",
      "required": ["protocolVersion", "session"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "session": { "$ref": "#/$defs/session" }
      },
      "additionalProperties": false
    },
    "historyMessage": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "historyResponse": {
      "type": "object",
      "required": ["protocolVersion", "sequence", "session", "messages", "startIndex", "totalMessages"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "session": { "$ref": "#/$defs/session" },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/historyMessage" } },
        "startIndex": { "type": "integer", "minimum": 0 },
        "totalMessages": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["protocolVersion", "sequence", "eventKind", "sessionId", "payload"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "sequence": { "type": "integer", "minimum": 1 },
        "eventKind": { "type": "string", "minLength": 1 },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "tabId": { "type": "string" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["protocolVersion", "error"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "error": {
          "title": "BridgeErrorBody",
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["unauthenticated", "invalid_request", "not_found", "conflict", "resync_required", "shutting_down", "internal"] },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
