{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonix.local/schemas/desktop-bridge/v1.json",
  "title": "Reasonix Desktop Bridge Protocol v1",
  "description": "JSON request and response bodies for the private loopback HTTP bridge. Route parameters are documented in BRIDGE_PROTOCOL.md.",
  "oneOf": [
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/providerSummaryResponse" },
    { "$ref": "#/$defs/providerModelProbeRequest" },
    { "$ref": "#/$defs/providerModelProbeResponse" },
    { "$ref": "#/$defs/setDefaultModelRequest" },
    { "$ref": "#/$defs/setSessionModelRequest" },
    { "$ref": "#/$defs/remoteConnectRequest" },
    { "$ref": "#/$defs/remoteConnectResponse" },
    { "$ref": "#/$defs/remoteDisconnectRequest" },
    { "$ref": "#/$defs/remoteDisconnectResponse" },
    { "$ref": "#/$defs/remoteBrowseRequest" },
    { "$ref": "#/$defs/remoteBrowseResponse" },
    { "$ref": "#/$defs/setAgentPreferenceRequest" },
    { "$ref": "#/$defs/openSessionRequest" },
    { "$ref": "#/$defs/renameSessionRequest" },
    { "$ref": "#/$defs/deleteSessionResponse" },
    { "$ref": "#/$defs/attachFileRequest" },
    { "$ref": "#/$defs/attachmentResponse" },
    { "$ref": "#/$defs/workspaceRequest" },
    { "$ref": "#/$defs/workspaceListResponse" },
    { "$ref": "#/$defs/workspaceFileRequest" },
    { "$ref": "#/$defs/workspaceFilePreview" },
    { "$ref": "#/$defs/workspaceFileResponse" },
    { "$ref": "#/$defs/workspaceChangeView" },
    { "$ref": "#/$defs/workspaceChanges" },
    { "$ref": "#/$defs/workspaceChangesResponse" },
    { "$ref": "#/$defs/workspaceChangeDetailRequest" },
    { "$ref": "#/$defs/workspaceChangeDetail" },
    { "$ref": "#/$defs/workspaceChangeDetailResponse" },
    { "$ref": "#/$defs/workspaceFileRevertPlan" },
    { "$ref": "#/$defs/workspaceFileRevertPlanResponse" },
    { "$ref": "#/$defs/workspaceFileRevertCommitRequest" },
    { "$ref": "#/$defs/workspaceFileRevertUndoRequest" },
    { "$ref": "#/$defs/workspaceFileRevertResult" },
    { "$ref": "#/$defs/workspaceFileRevertResultResponse" },
    { "$ref": "#/$defs/workspaceCheckpointView" },
    { "$ref": "#/$defs/workspaceCheckpointsResponse" },
    { "$ref": "#/$defs/codeRewindPreviewRequest" },
    { "$ref": "#/$defs/workspaceCodeRewindPlan" },
    { "$ref": "#/$defs/codeRewindPlanResponse" },
    { "$ref": "#/$defs/codeRewindCommitRequest" },
    { "$ref": "#/$defs/conversationRewindPreviewRequest" },
    { "$ref": "#/$defs/workspaceConversationRewindPlan" },
    { "$ref": "#/$defs/conversationRewindPlanResponse" },
    { "$ref": "#/$defs/conversationRewindCommitRequest" },
    { "$ref": "#/$defs/conversationRewindUndoRequest" },
    { "$ref": "#/$defs/workspaceConversationRewindResult" },
    { "$ref": "#/$defs/conversationRewindResultResponse" },
    { "$ref": "#/$defs/sessionHeadView" },
    { "$ref": "#/$defs/sessionHeadsResponse" },
    { "$ref": "#/$defs/sessionHeadSwitchRequest" },
    { "$ref": "#/$defs/sessionHeadSwitchResponse" },
    { "$ref": "#/$defs/submitRequest" },
    { "$ref": "#/$defs/approvalRequest" },
    { "$ref": "#/$defs/askAnswer" },
    { "$ref": "#/$defs/answerQuestionRequest" },
    { "$ref": "#/$defs/mcpInteractionAnswerRequest" },
    { "$ref": "#/$defs/sessionResponse" },
    { "$ref": "#/$defs/historyResponse" },
    { "$ref": "#/$defs/projectFoldersResponse" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "protocolVersion": { "type": "integer", "const": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "session": {
      "type": "object",
      "required": ["id", "path", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/sessionId" },
        "path": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "workspaceRoot": { "type": "string" },
        "modelRef": { "type": "string", "minLength": 1 },
        "state": { "enum": ["idle", "running", "paused"] }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": ["protocolVersion", "status", "sidecarInstanceId", "capabilities"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "status": { "const": "ok" },
        "sidecarInstanceId": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "providerSummary": {
      "title": "BridgeProviderSummary",
      "type": "object",
      "required": ["name", "kind", "models", "visionModels", "searchModels", "modelCount", "requiresKey", "configured"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" },
        "kind": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" } },
        "visionModels": { "type": "array", "items": { "type": "string" } },
        "searchModels": { "type": "array", "items": { "type": "string" } },
        "modelCount": { "type": "integer", "minimum": 0 },
        "requiresKey": { "type": "boolean" },
        "configured": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "setDefaultModelRequest": {
      "title": "BridgeSetDefaultModelRequest",
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "enum": ["global", "project"] },
        "workspaceRoot": { "type": "string", "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "setSessionModelRequest": {
      "title": "BridgeSetSessionModelRequest",
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "remoteConnectRequest": {
      "title": "BridgeRemoteConnectRequest",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "trustFingerprint": { "type": "string", "maxLength": 256 },
        "password": { "type": "string", "maxLength": 4096 },
        "passphrase": { "type": "string", "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "remoteConnectResponse": {
      "title": "BridgeRemoteConnectResponse",
      "type": "object",
      "required": ["protocolVersion", "status"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "status": { "enum": ["connected", "host_key_confirmation", "failed"] },
        "host": { "type": "string" },
        "address": { "type": "string" },
        "keyType": { "type": "string" },
        "fingerprint": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "remoteDisconnectRequest": {
      "title": "BridgeRemoteDisconnectRequest",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "remoteDisconnectResponse": {
      "title": "BridgeRemoteDisconnectResponse",
      "type": "object",
      "required": ["protocolVersion", "disconnected", "name"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "disconnected": { "type": "boolean", "const": true },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "remoteBrowseRequest": {
      "title": "BridgeRemoteBrowseRequest",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "path": { "type": "string", "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "remoteBrowseEntry": {
      "type": "object",
      "required": ["name", "path", "isDir", "symlink", "size", "modTime"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "isDir": { "type": "boolean" },
        "symlink": { "type": "boolean" },
        "size": { "type": "integer" },
        "modTime": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "remoteBrowseResponse": {
      "title": "BridgeRemoteBrowseResponse",
      "type": "object",
      "required": ["protocolVersion", "path", "parentPath", "entries", "truncated"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "path": { "type": "string" },
        "parentPath": { "type": "string" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/remoteBrowseEntry" } },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "remoteFilePreviewRequest": {
      "title": "BridgeRemoteFilePreviewRequest",
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "remoteFilePreviewResponse": {
      "title": "BridgeRemoteFilePreviewResponse",
      "type": "object",
      "required": ["protocolVersion", "path", "kind", "content", "revision", "truncated"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "path": { "type": "string" },
        "kind": { "type": "string", "enum": ["text", "binary"] },
        "content": { "type": "string" },
        "revision": { "type": "string", "maxLength": 64 },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "remoteFileSaveRequest": {
      "title": "BridgeRemoteFileSaveRequest",
      "type": "object",
      "required": ["name", "path", "revision", "content"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "content": { "type": "string", "maxLength": 1048576 }
      },
      "additionalProperties": false
    },
    "remoteFileSaveResponse": {
      "title": "BridgeRemoteFileSaveResponse",
      "type": "object",
      "required": ["protocolVersion", "path", "revision"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "path": { "type": "string" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "setModelRoleRequest": {
      "title": "BridgeSetModelRoleRequest",
      "type": "object",
      "required": ["role", "model"],
      "properties": {
        "role": { "type": "string", "enum": ["planner", "vision", "search"] },
        "model": { "type": "string" },
        "scope": { "type": "string", "enum": ["global", "project"] },
        "workspaceRoot": { "type": "string", "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "setAgentPreferenceRequest": {
      "title": "BridgeSetAgentPreferenceRequest",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "properties": {
        "reasoningLanguage": { "enum": ["auto", "zh", "en"] },
        "compactRatioPercent": { "type": "number", "minimum": 30, "maximum": 85, "multipleOf": 0.1 },
        "scope": { "type": "string", "enum": ["global", "project"] },
        "workspaceRoot": { "type": "string", "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "providerSummaryResponse": {
      "title": "BridgeProviderSummaryResponse",
      "type": "object",
      "required": ["protocolVersion", "scope", "defaultModel", "plannerModel", "visionModel", "webSearchModel", "reasoningLanguage", "compactRatioPercent", "providers"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "scope": { "type": "string", "enum": ["global", "project"] },
        "defaultModel": { "type": "string" },
        "plannerModel": { "type": "string" },
        "visionModel": { "type": "string" },
        "webSearchModel": { "type": "string" },
        "reasoningLanguage": { "enum": ["auto", "zh", "en"] },
        "compactRatioPercent": { "type": "number", "minimum": 30, "maximum": 90, "multipleOf": 0.1 },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/providerSummary" } }
      },
      "additionalProperties": false
    },
    "providerModelProbeRequest": {
      "title": "BridgeProviderModelProbeRequest",
      "type": "object",
      "required": ["name", "model"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "apiKey": { "type": "string", "maxLength": 16384 }
      },
      "additionalProperties": false
    },
    "providerModelProbeResponse": {
      "title": "BridgeProviderModelProbeResponse",
      "type": "object",
      "required": ["protocolVersion", "latencyMillis"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "latencyMillis": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "openSessionRequest": {
      "type": "object",
      "required": ["sessionId"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "workspaceRoot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "renameSessionRequest": {
      "title": "BridgeRenameSessionRequest",
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "deleteSessionResponse": {
      "title": "BridgeDeleteSessionResponse",
      "type": "object",
      "required": ["protocolVersion", "deleted", "sessionId"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "deleted": { "type": "boolean", "const": true },
        "sessionId": { "$ref": "#/$defs/sessionId" }
      },
      "additionalProperties": false
    },
    "submitRequest": {
      "type": "object",
      "required": ["input"],
      "properties": {
        "input": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "approvalRequest": {
      "title": "BridgeApprovalRequest",
      "type": "object",
      "required": ["id", "allow"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "allow": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "askAnswer": {
      "title": "BridgeAskAnswer",
      "type": "object",
      "required": ["questionId", "selected"],
      "properties": {
        "questionId": { "type": "string", "minLength": 1 },
        "selected": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "answerQuestionRequest": {
      "title": "BridgeAnswerQuestionRequest",
      "type": "object",
      "required": ["id", "answers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "answers": { "type": "array", "items": { "$ref": "#/$defs/askAnswer" } }
      },
      "additionalProperties": false
    },
    "mcpInteractionAnswerRequest": {
      "title": "BridgeMCPInteractionAnswerRequest",
      "type": "object",
      "required": ["id", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["accept", "decline", "cancel"] },
        "content": { "type": "object" }
      },
      "additionalProperties": false
    },
    "attachFileRequest": {
      "type": "object",
      "required": ["sessionId", "path"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "required": ["path", "name", "size", "isImage"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "isImage": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "attachmentResponse": {
      "type": "object",
      "required": ["protocolVersion", "attachment"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "attachment": { "$ref": "#/$defs/attachment" }
      },
      "additionalProperties": false
    },
    "workspaceRequest": {
      "title": "BridgeWorkspaceRequest",
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workspaceEntry": {
      "title": "BridgeWorkspaceEntry",
      "type": "object",
      "required": ["name", "path", "isDir"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "isDir": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workspaceListResponse": {
      "title": "BridgeWorkspaceListResponse",
      "type": "object",
      "required": ["protocolVersion", "path", "entries", "truncated"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "path": { "type": "string" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/workspaceEntry" } },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workspaceFileRequest": {
      "title": "BridgeWorkspaceFileRequest",
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workspaceFilePreview": {
      "title": "BridgeWorkspaceFilePreview",
      "type": "object",
      "required": ["path", "size"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "binary": { "type": "boolean" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workspaceFileResponse": {
      "title": "BridgeWorkspaceFileResponse",
      "type": "object",
      "required": ["protocolVersion", "preview"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "preview": { "$ref": "#/$defs/workspaceFilePreview" }
      },
      "additionalProperties": false
    },
    "workspaceChangeView": {
      "title": "BridgeWorkspaceChangeView",
      "type": "object",
      "required": ["path", "sources"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "oldPath": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "gitStatus": { "type": "string" },
        "turns": { "type": "array", "items": { "type": "integer" } },
        "latestPrompt": { "type": "string" },
        "latestTime": { "type": "integer" },
        "canSessionRevert": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workspaceChanges": {
      "title": "BridgeWorkspaceChanges",
      "type": "object",
      "required": ["files", "gitAvailable"],
      "properties": {
        "files": { "type": "array", "items": { "$ref": "#/$defs/workspaceChangeView" } },
        "gitAvailable": { "type": "boolean" },
        "gitErr": { "type": "string" },
        "gitBranch": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workspaceChangesResponse": {
      "title": "BridgeWorkspaceChangesResponse",
      "type": "object",
      "required": ["protocolVersion", "changes"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "changes": { "$ref": "#/$defs/workspaceChanges" }
      },
      "additionalProperties": false
    },
    "workspaceChangeDetailRequest": {
      "title": "BridgeWorkspaceChangeDetailRequest",
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workspaceChangeDetail": {
      "title": "BridgeWorkspaceChangeDetail",
      "type": "object",
      "properties": {
        "diff": { "type": "string" },
        "source": { "type": "string" },
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "binary": { "type": "boolean" },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workspaceChangeDetailResponse": {
      "title": "BridgeWorkspaceChangeDetailResponse",
      "type": "object",
      "required": ["protocolVersion", "detail"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "detail": { "$ref": "#/$defs/workspaceChangeDetail" }
      },
      "additionalProperties": false
    },
    "workspaceFileRevertPlan": {
      "title": "BridgeWorkspaceFileRevertPlan",
      "type": "object",
      "required": ["path", "canFiles"],
      "properties": {
        "planId": { "type": "string" },
        "path": { "type": "string" },
        "canFiles": { "type": "boolean" },
        "disabledReason": { "type": "string" },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "legacy": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workspaceFileRevertPlanResponse": {
      "title": "BridgeWorkspaceFileRevertPlanResponse",
      "type": "object",
      "required": ["protocolVersion", "plan"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "plan": { "$ref": "#/$defs/workspaceFileRevertPlan" }
      },
      "additionalProperties": false
    },
    "workspaceFileRevertCommitRequest": {
      "title": "BridgeWorkspaceFileRevertCommitRequest",
      "type": "object",
      "required": ["planId", "resolution"],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "enum": ["", "overwrite_checkpoint"] }
      },
      "additionalProperties": false
    },
    "workspaceFileRevertUndoRequest": {
      "title": "BridgeWorkspaceFileRevertUndoRequest",
      "type": "object",
      "required": ["transactionId"],
      "properties": {
        "transactionId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workspaceFileRevertResult": {
      "title": "BridgeWorkspaceFileRevertResult",
      "type": "object",
      "required": ["ok", "undoAvailable", "writtenCount", "deletedCount"],
      "properties": {
        "ok": { "type": "boolean" },
        "transactionId": { "type": "string" },
        "undoAvailable": { "type": "boolean" },
        "writtenCount": { "type": "integer", "minimum": 0 },
        "deletedCount": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "workspaceFileRevertResultResponse": {
      "title": "BridgeWorkspaceFileRevertResultResponse",
      "type": "object",
      "required": ["protocolVersion", "result"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "result": { "$ref": "#/$defs/workspaceFileRevertResult" }
      },
      "additionalProperties": false
    },
    "workspaceCheckpointView": {
      "title": "BridgeWorkspaceCheckpointView",
      "type": "object",
      "required": ["turn", "prompt", "time", "turnFileCount"],
      "properties": {
        "turn": { "type": "integer", "minimum": 0 },
        "prompt": { "type": "string" },
