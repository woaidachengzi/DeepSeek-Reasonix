+  if (typeof window === "undefined" || !window.runtime?.EventsOn) return () => {};
+  let active = true;
+  const off = window.runtime.EventsOn(name, (...data) => { if (active) cb(...data); });
+  return () => {
+    if (!active) return;
+    active = false;
+    off();
+  };
+}
