diff --git a/desktop/tauri/src/tray.rs b/desktop/tauri/src/tray.rs
index 69c37c433..f6cb9d985 100644
--- a/desktop/tauri/src/tray.rs
+++ b/desktop/tauri/src/tray.rs
@@ -53,6 +53,14 @@ pub fn show_main_window(app: &tauri::AppHandle) {
             let _ = window.unminimize();
             let _ = window.show();
             let _ = window.set_focus();
+            #[cfg(target_os = "macos")]
+            if let Some(main_thread) = objc2::MainThreadMarker::new() {
+                let application = objc2_app_kit::NSApplication::sharedApplication(main_thread);
+                use objc2_foundation::NSObjectProtocol;
+                if application.respondsToSelector(objc2::sel!(activate)) {
+                    application.activate();
+                }
+            }
         }
         #[cfg(target_os = "macos")]
         crate::native_window_smoke::observe_restore(&handle, true);
