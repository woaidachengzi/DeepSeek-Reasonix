+// Private interactive acceptance only. Observe fixed gesture classes without
+// characters, coordinates or content; pass each borrowed event through unchanged.
+// AppKit tracking loops may bypass this monitor, so absence is not non-delivery.
+fn install_input_monitor(app: &AppHandle) -> Result<(), String> {
+    use block2::RcBlock;
+    use objc2_app_kit::{NSEvent, NSEventMask, NSEventModifierFlags, NSEventType, NSWindow};
+    objc2::MainThreadMarker::new().ok_or("input monitor requires main thread")?;
+    let window = app.get_webview_window("main").ok_or("input monitor window missing")?;
+    let pointer = window.ns_window().map_err(|_| "input monitor handle missing")?;
+    if pointer.is_null() { return Err("input monitor handle null".into()); }
+    // SAFETY: Borrowed live main NSWindow, read on its owning thread; only its
+    // scalar number escapes, never the native pointer or event payload.
+    let number = unsafe { &*pointer.cast::<NSWindow>() }.windowNumber();
+    let counters = Arc::clone(&app.state::<WindowSmokeState>().transitions);
+    let callback = RcBlock::new(move |event: std::ptr::NonNull<NSEvent>| {
+        // SAFETY: AppKit supplies a live event for this callback. The original
+        // pointer is returned synchronously and is never stored or consumed.
+        let value = unsafe { event.as_ref() };
+        if value.windowNumber() == number {
+            if value.r#type() == NSEventType::LeftMouseDown {
+                counters.note(16);
+            } else if value.r#type() == NSEventType::KeyDown {
+                let modifiers = value.modifierFlags() & (NSEventModifierFlags::Command
+                    | NSEventModifierFlags::Control | NSEventModifierFlags::Shift | NSEventModifierFlags::Option);
+                // Fixed macOS virtual key positions; no arbitrary keystrokes
+                // are retained. These counts do not imply a menu action fired.
+                if value.keyCode() == 46 && modifiers == NSEventModifierFlags::Command {
+                    counters.note(14);
+                } else if value.keyCode() == 3 && modifiers == (NSEventModifierFlags::Control | NSEventModifierFlags::Command) {
+                    counters.note(15);
+                }
+            }
+        }
+        event.as_ptr()
+    });
+    INPUT_MONITOR.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        if slot.is_some() { return Err("input monitor already registered".into()); }
+        // SAFETY: Callback returns its unchanged live argument, never null or
+        // a newly owned event; removal uses this exact retained token on main.
+        *slot = unsafe { NSEvent::addLocalMonitorForEventsMatchingMask_handler(
+            NSEventMask::KeyDown | NSEventMask::LeftMouseDown, &callback) };
+        if slot.is_none() { return Err("input monitor registration failed".into()); }
+        Ok(())
+    })
+}
