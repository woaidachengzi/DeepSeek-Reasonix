+// Query the responder chain only; never send an action or retain its target.
+// Present/identity booleans do not prove role invocation or transition success.
+fn action_context(number: isize, minimize: bool) -> Option<(bool, bool, bool)> {
+    use objc2_app_kit::{NSApplication, NSWindow};
+    let application = NSApplication::sharedApplication(objc2::MainThreadMarker::new()?);
+    let main_key = application.keyWindow().is_some_and(|window| window.windowNumber() == number);
+    let selector = if minimize { objc2::sel!(performMiniaturize:) } else { objc2::sel!(toggleFullScreen:) };
+    // SAFETY: Valid standard AppKit selectors; nil target/sender requests only
+    // responder resolution. This call does not invoke either window action.
+    let target = unsafe { application.targetForAction_to_from(selector, None, None) };
+    let main_target = target.as_ref().and_then(|target| target.downcast_ref::<NSWindow>())
+        .is_some_and(|window| window.windowNumber() == number);
+    Some((main_key, target.is_some(), main_target))
+}
