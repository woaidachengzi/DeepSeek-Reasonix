{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Least-privilege capability set for the local Reasonix window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:tray:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "shell:allow-open",
    "updater:default",
    "notification:default"
  ]
}
