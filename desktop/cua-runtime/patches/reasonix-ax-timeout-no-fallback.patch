+//! A background AX timeout is an uncertain dispatch, not permission to mutate again.
+use cua_driver_core::protocol::ToolResult;
+
+pub(super) fn press_error_may_have_acted(error: i32, foreground: bool) -> bool {
+    use crate::ax::bindings::{
+        kAXErrorActionUnsupported, kAXErrorAttributeUnsupported, kAXErrorFailure,
+    };
+    [
+        kAXErrorFailure,
+        kAXErrorAttributeUnsupported,
+        kAXErrorActionUnsupported,
+    ]
+    .contains(&error)
+        || (error == -25204 && !foreground)
+}
+
+#[derive(Debug)]
+struct UncertainAxDispatch(String);
+
+impl std::fmt::Display for UncertainAxDispatch {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{}", self.0)
+    }
+}
+
+impl std::error::Error for UncertainAxDispatch {}
+
+pub(super) fn ax_dispatch_error<T>(
+    action: &str,
+    error: i32,
+    foreground: bool,
+    fallback: impl FnOnce() -> T,
+) -> anyhow::Result<T> {
+    if error == -25204 && !foreground {
+        return Err(UncertainAxDispatch(action.to_owned()).into());
+    }
+    Ok(fallback())
+}
+
+pub(super) fn ax_error_result(error: anyhow::Error) -> ToolResult {
+    if let Some(dispatch) = error.downcast_ref::<UncertainAxDispatch>() {
+        return ToolResult::text(format!(
+            "macOS could not complete {} (-25204). The action may have occurred; inspect fresh state before repeating it.",
+            dispatch.0
+        ))
+        .with_structured(serde_json::json!({"path":"ax", "effect":"unverifiable", "verified":false}));
+    }
+    ToolResult::error(format!("AX action failed: {error}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cua_driver_core::{
+        authorization::PermissionMode,
+        session_authorization::{SessionAuthorizationRegistry, SessionModeCeiling},
+        tool::{Tool, ToolDef, ToolRegistry},
+    };
+    use std::{
+        sync::{
+            atomic::{AtomicUsize, Ordering},
+            Arc,
+        },
+        time::Duration,
+    };
+
+    #[test]
+    fn background_timeout_never_runs_the_selection_fallback() {
+        assert!(press_error_may_have_acted(-25204, false));
+        assert!(!press_error_may_have_acted(-25204, true));
+        let error =
+            ax_dispatch_error("AXPress", -25204, false, || panic!("second mutation")).unwrap_err();
+        let result = ax_error_result(error);
+        assert_ne!(result.is_error, Some(true));
+        assert_eq!(result.structured_content.unwrap()["effect"], "unverifiable");
+    }
+
+    #[test]
+    fn foreground_timeout_and_other_errors_keep_existing_policy() {
+        for (error, foreground) in [(-25204, true), (-25202, false)] {
+            assert_eq!(
+                ax_dispatch_error("AXPress", error, foreground, || "fallback").unwrap(),
+                "fallback"
+            );
+        }
+        for error in [-25200, -25205, -25206] {
+            assert!(press_error_may_have_acted(error, false));
+            assert!(press_error_may_have_acted(error, true));
+        }
+        for error in [-25201, -25202, -25211] {
+            assert!(!press_error_may_have_acted(error, false));
+        }
+        assert_eq!(
+            ax_error_result(anyhow::anyhow!("ordinary failure")).is_error,
+            Some(true)
+        );
+    }
+
+    struct TimeoutTool {
+        definition: ToolDef,
+        calls: Arc<AtomicUsize>,
+    }
+
+    #[async_trait::async_trait]
+    impl Tool for TimeoutTool {
+        fn def(&self) -> &ToolDef {
+            &self.definition
+        }
+        async fn invoke(&self, _: serde_json::Value) -> ToolResult {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            ax_error_result(
+                ax_dispatch_error("AXPress", -25204, false, || panic!("second input")).unwrap_err(),
+            )
+        }
+    }
+
+    #[tokio::test]
+    async fn public_dispatch_preserves_uncertainty_without_replaying() {
+        let ceiling = SessionModeCeiling::for_trusted_sessions(
+            [PermissionMode::Standard],
+            false,
+            Duration::from_secs(60),
+            Duration::from_secs(30),
+        )
+        .unwrap();
+        let context = SessionAuthorizationRegistry::with_ceiling(ceiling)
+            .compatibility_context(PermissionMode::Standard, None)
+            .unwrap();
+        let session = context.runtime_session_key("timeout-fixture");
+        let mut registry = ToolRegistry::new();
+        registry
+            .protected_resource_ownership()
+            .mark_driver_owned_pid(&session, 42);
+        let calls = Arc::new(AtomicUsize::new(0));
+        registry.register(Box::new(TimeoutTool {
+            definition: ToolDef {
+                name: "click".into(),
+                description: "fixture".into(),
+                input_schema: serde_json::json!({"type":"object"}),
+                read_only: false,
+                destructive: false,
+                idempotent: false,
+                open_world: false,
+            },
+            calls: calls.clone(),
+        }));
+        let result = registry.invoke_with_context("click", serde_json::json!({
+            "pid":42, "window_id":7, "element_token":"s00000001:1", "session":"timeout-fixture"
+        }), context).await;
+        assert_ne!(result.is_error, Some(true));
+        let result = result.structured_content.unwrap();
+        assert_eq!(result["effect"], "unverifiable");
+        assert!(result["summary"]
+            .as_str()
+            .unwrap()
+            .contains("inspect fresh state"));
+        assert_eq!(result["next_call"]["tool"], "get_window_state");
+        assert!(result.get("error").is_none());
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+    }
+}
