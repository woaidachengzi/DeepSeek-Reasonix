new file mode 100644
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/tree_query.rs
@@ -0,0 +1,127 @@
+//! Query walks spend separate budgets on raw visits and returned rows.
+use cua_driver_core::walk_budget::WalkBudget;
+use std::collections::BTreeSet;
+
+pub(super) const MAX_QUERY_VISITS: usize = 20_000;
+pub(super) const MAX_RAW_DEPTH: usize = 128;
+
+pub(super) struct QueryScan {
+    needle: String,
+    limit: usize,
+    ancestors: Vec<(usize, usize)>,
+    retained: BTreeSet<usize>,
+    full: bool,
+}
+
+impl QueryScan {
+    pub(super) fn new(query: Option<&str>, budget: &mut WalkBudget) -> Option<Self> {
+        let needle = query?.trim().to_lowercase();
+        if needle.is_empty() {
+            return None;
+        }
+        let limit = budget.node_limit().min(MAX_QUERY_VISITS);
+        budget.set_node_limit(MAX_QUERY_VISITS);
+        Some(Self {
+            needle,
+            limit,
+            ancestors: Vec::new(),
+            retained: BTreeSet::new(),
+            full: limit == 0,
+        })
+    }
+
+    pub(super) fn admit(&self, budget: &mut WalkBudget) -> bool {
+        if self.full {
+            budget.stop_for_node_budget();
+        }
+        budget.admit()
+    }
+
+    // Row positions refer to the unfiltered walk, preserving element tokens.
+    // Ancestors count towards the output bound too, not only matching rows.
+    pub(super) fn record(&mut self, depth: usize, row: usize, text: &str) {
+        self.ancestors.retain(|(d, _)| *d < depth);
+        self.ancestors.push((depth, row));
+        if !text.to_lowercase().contains(&self.needle) {
+            return;
+        }
+        let added = self
+            .ancestors
+            .iter()
+            .filter(|(_, position)| !self.retained.contains(position))
+            .count();
+        if self.retained.len() + added > self.limit {
+            self.full = true;
+            return;
+        }
+        self.retained.extend(self.ancestors.iter().map(|(_, i)| *i));
+        self.full = self.retained.len() == self.limit;
+    }
+
+    pub(super) fn retains(&self, row: usize) -> bool {
+        self.retained.contains(&row)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn query_finds_a_footer_after_thousands_of_unmatched_rows() {
+        let mut budget = WalkBudget::nodes_only(3);
+        let mut query = QueryScan::new(Some("Apply"), &mut budget).unwrap();
+        assert!(query.admit(&mut budget));
+        query.record(0, 0, "window");
+        for row in 1..=3000 {
+            assert!(query.admit(&mut budget));
+            query.record(1, row, "telemetry row");
+        }
+        assert!(query.admit(&mut budget));
+        query.record(1, 3001, "Apply changes");
+        assert!(query.retains(0));
+        assert!(query.retains(3001));
+        assert!(!query.retains(1));
+        assert!(!budget.outcome().truncated());
+    }
+
+    #[test]
+    fn ancestors_share_the_output_budget_and_indices_are_not_renumbered() {
+        let mut budget = WalkBudget::nodes_only(3);
+        let mut query = QueryScan::new(Some("Apply"), &mut budget).unwrap();
+        for (row, depth, text) in [
+            (0, 0, "window"),
+            (1, 1, "pane"),
+            (2, 2, "ignored"),
+            (3, 2, "Apply"),
+        ] {
+            assert!(query.admit(&mut budget));
+            query.record(depth, row, text);
+        }
+        assert_eq!(query.retained, BTreeSet::from([0, 1, 3]));
+        assert!(!query.admit(&mut budget));
+        assert_eq!(budget.outcome().reason(), Some("node_budget"));
+    }
+
+    #[test]
+    fn a_query_without_matches_still_has_a_raw_visit_ceiling() {
+        let mut budget = WalkBudget::nodes_only(10);
+        let query = QueryScan::new(Some("missing"), &mut budget).unwrap();
+        for _ in 0..MAX_QUERY_VISITS {
+            assert!(query.admit(&mut budget));
+        }
+        assert!(!query.admit(&mut budget));
+        assert_eq!(budget.outcome().nodes_visited, MAX_QUERY_VISITS);
+    }
+
+    #[test]
+    fn query_keeps_the_clock_and_blank_queries_keep_the_original_budget() {
+        let mut clock = WalkBudget::new(0, 20);
+        let query = QueryScan::new(Some("Apply"), &mut clock).unwrap();
+        assert!(!query.admit(&mut clock));
+        assert_eq!(clock.outcome().reason(), Some("timeout"));
+        let mut blank = WalkBudget::nodes_only(2);
+        assert!(QueryScan::new(Some("  "), &mut blank).is_none());
+        assert_eq!(blank.node_limit(), 2);
+    }
+}
