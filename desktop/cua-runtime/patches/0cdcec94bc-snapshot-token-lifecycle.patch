+/// How many retired snapshot ids a runtime remembers, so a refusal for a token
+/// whose snapshot is gone can still name the process (and so the current
+/// snapshots) it belonged to.
+const RETIRED_MEMORY: usize = 256;
+
+/// What one caller's reads of one window looked like.
+#[derive(Clone, Copy, Debug)]
+struct ReadRecord {
+    /// The snapshot the caller's most recent read of the window printed.
+    snapshot_id: u32,
+    /// How many reads of the window printed rows for this caller.
+    reads: u32,
+}
+
+/// Everything one runtime remembers about published snapshots.
+struct SnapshotState<S> {
+    lanes: HashMap<i32, Vec<Snapshot<S>>>,
+    /// Element reads a caller has made of a window: `(session, pid, window)`
+    /// -> how many reads printed rows. A bare row number names a read only
+    /// while its caller has read that window exactly once, because a second
+    /// read can put a different element at the same row. The count outlives
+    /// eviction, so the caller's *second* read is what stops a row from the
+    /// first being re-pointed.
+    reads: HashMap<(String, i32, u64), ReadRecord>,
+    /// Recently retired snapshot ids with the pid that minted them, oldest
+    /// first. This is what lets a token-only call learn whose snapshots
+    /// replaced the one it named.
+    retired: VecDeque<(u32, i32)>,
+}
+
+impl<S> SnapshotState<S> {
+    fn new() -> Self {
+        Self {
+            lanes: HashMap::new(),
+            reads: HashMap::new(),
+            retired: VecDeque::new(),
+        }
+    }
+
+    fn lane(&self, pid: i32) -> &[Snapshot<S>] {
+        self.lanes.get(&pid).map(Vec::as_slice).unwrap_or_default()
+    }
+
+    fn remember_retired(&mut self, pid: i32, ids: impl IntoIterator<Item = u32>) {
+        for id in ids {
+            if self.retired.len() == RETIRED_MEMORY {
+                self.retired.pop_front();
+            }
+            self.retired.push_back((id, pid));
+        }
+    }
+
+    /// The current snapshots of `pid`, in the shape every stale refusal reports.
+    fn current_snapshots(&self, pid: i32) -> Vec<CurrentSnapshot> {
+        self.lane(pid)
+            .iter()
+            .map(|snapshot| CurrentSnapshot {
+                snapshot_id: format_snapshot_id(snapshot.id),
+                window_id: snapshot.window_id,
+            })
+            .collect()
+    }
+
+    /// The pid a snapshot id was minted for, while that snapshot is current.
+    fn pid_of_current(&self, snapshot_id: u32) -> Option<i32> {
+        self.lanes
+            .iter()
+            .find(|(_, lane)| lane.iter().any(|snapshot| snapshot.id == snapshot_id))
+            .map(|(pid, _)| *pid)
+    }
+
+    /// The pid a snapshot id was minted for, including ids retired earlier.
+    fn pid_of(&self, snapshot_id: u32) -> Option<i32> {
+        self.pid_of_current(snapshot_id).or_else(|| {
+            self.retired
+                .iter()
+                .rev()
+                .find(|(id, _)| *id == snapshot_id)
+                .map(|(_, pid)| *pid)
+        })
+    }
+}
