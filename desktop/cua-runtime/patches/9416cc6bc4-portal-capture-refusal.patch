+        || msg.contains("NotFound")
+    {
+        format!("xdg-desktop-portal is not running on this session ({msg}). Install xdg-desktop-portal-gnome / xdg-desktop-portal-kde / xdg-desktop-portal-wlr for your compositor.")
+    } else {
+        msg
+    }
 }
 
