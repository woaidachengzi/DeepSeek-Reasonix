+use cua_driver_core::protocol::ToolResult;
+
+// A background AX insert followed by Unicode keys has been observed to insert
+// twice in Gecko. Refuse the known browser families before either actuator;
+// their explicitly requested foreground path remains separately verifiable.
+pub(super) fn gecko_background_refusal(
+    bundle_id: Option<&str>,
+    foreground: bool,
+) -> Option<ToolResult> {
+    let gecko = matches!(
+        bundle_id,
+        Some(
+            "org.mozilla.firefox"
+                | "org.mozilla.firefoxdeveloperedition"
+                | "org.mozilla.nightly"
+                | "app.zen-browser.zen"
+        )
+    );
+    if !gecko || foreground {
+        return None;
+    }
+    Some(ToolResult::error(
+        "Native background text delivery to this Gecko browser is not proven safe: an AX insert and keyboard fallback may duplicate text. No text was sent. Request explicit foreground delivery for the exact window, then verify the field from fresh state; do not blindly resend."
+    ).with_structured(serde_json::json!({
+        "code":"GECKO_BACKGROUND_TEXT_UNSUPPORTED", "effect":"refused", "verified":false,
+        "escalation":{"recommended":"foreground", "requires":["window_id"]}
+    })))
+}
+
+// A successful/uncertain AX write owns this call's one insertion attempt.
+// Keep the entire keyboard fallback behind this boundary, including policy and
+// pacing checks, so an uncertain write cannot be relabelled "no input sent".
+pub(super) fn after_ax_attempt(
+    attempt: super::AxAttempt,
+    fallback: impl FnOnce() -> anyhow::Result<super::TypeTextDelivery>,
+) -> anyhow::Result<super::TypeTextDelivery> {
+    if attempt == super::AxAttempt::Unverifiable {
+        return Ok(super::TypeTextDelivery::Typed(super::TypeTextOutcome {
+            detail: " via AX; delivery is uncertain, so no CGEvent fallback was sent. Inspect fresh state before further input".into(),
+            path: super::PATH_AX, verified: false, delivered_chars: None,
+        }));
+    }
+    fallback()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn an_uncertain_ax_attempt_never_runs_the_keyboard_actuator() {
+        let calls = std::cell::Cell::new(0);
+        let result = after_ax_attempt(super::super::AxAttempt::Unverifiable, || {
+            calls.set(calls.get() + 1);
+            panic!("duplicate insertion");
+        })
+        .unwrap();
+        assert_eq!(calls.get(), 0);
+        let super::super::TypeTextDelivery::Typed(outcome) = result else {
+            panic!("a possible write must be uncertain, not refused");
+        };
+        assert_eq!(outcome.path, super::super::PATH_AX);
+        assert!(!outcome.verified);
+        assert_eq!(outcome.delivered_chars, None);
+        assert!(outcome.detail.contains("no CGEvent fallback"));
+        for attempt in [
+            super::super::AxAttempt::Rejected,
+            super::super::AxAttempt::Unchanged,
+            super::super::AxAttempt::NotAttempted,
+        ] {
+            let _ = after_ax_attempt(attempt, || {
+                calls.set(calls.get() + 1);
+                Err(anyhow::anyhow!("test actuator"))
+            });
+        }
+        assert_eq!(calls.get(), 3);
+    }
+
+    #[test]
+    fn gecko_background_refuses_without_claiming_text_delivery() {
+        for bundle in [
+            "org.mozilla.firefox",
+            "org.mozilla.firefoxdeveloperedition",
+            "org.mozilla.nightly",
+            "app.zen-browser.zen",
+        ] {
+            let result = gecko_background_refusal(Some(bundle), false).unwrap();
+            assert_eq!(result.is_error, Some(true));
+            let value = result.structured_content.unwrap();
+            assert_eq!(value["code"], "GECKO_BACKGROUND_TEXT_UNSUPPORTED");
+            assert_eq!(value["effect"], "refused");
+            assert_eq!(value["verified"], false);
+            assert!(gecko_background_refusal(Some(bundle), true).is_none());
+        }
+        for bundle in [
+            None,
+            Some("com.apple.Safari"),
+            Some("com.google.Chrome"),
+            Some("app.zen-browser.zen.helper"),
+        ] {
+            assert!(gecko_background_refusal(bundle, false).is_none());
+        }
+    }
